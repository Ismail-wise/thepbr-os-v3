# thePBR OS V3 — Production target environment example
# NON-SECRET TEMPLATE ONLY.
# Production infrastructure is NOT authorized or provisioned by F0-E1.

APP_NAME="thePBR OS V3"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://CHANGE_ME_PRODUCTION_HOST

DB_CONNECTION=pgsql
DB_HOST=CHANGE_ME_PRODUCTION_DB_HOST
DB_PORT=5432
DB_DATABASE=pbr_production
DB_USERNAME=pbr_production
DB_PASSWORD=CHANGE_ME_RUNTIME_SECRET

CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=CHANGE_ME_PRODUCTION_REDIS_HOST
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=CHANGE_ME_RUNTIME_SECRET
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=pbr_v3_production_
REDIS_QUEUE_CONNECTION=default
REDIS_CACHE_CONNECTION=cache

SESSION_DRIVER=redis
SESSION_STORE=redis
SESSION_CONNECTION=default
SESSION_PREFIX=sessions:
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# V1 Production target: private S3-compatible object storage.
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=CHANGE_ME_RUNTIME_SECRET
AWS_SECRET_ACCESS_KEY=CHANGE_ME_RUNTIME_SECRET
AWS_DEFAULT_REGION=CHANGE_ME_APPROVED_REGION
AWS_BUCKET=CHANGE_ME_PRODUCTION_PRIVATE_BUCKET
AWS_ENDPOINT=CHANGE_ME_S3_COMPATIBLE_ENDPOINT
AWS_USE_PATH_STYLE_ENDPOINT=false
