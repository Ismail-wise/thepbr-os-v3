# thePBR OS V3 — Preview / Staging environment example
# NON-SECRET TEMPLATE ONLY.
# This does not provision or deploy Preview.

APP_NAME="thePBR OS V3"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://CHANGE_ME_PREVIEW_HOST

DB_CONNECTION=pgsql
DB_HOST=CHANGE_ME_PREVIEW_DB_HOST
DB_PORT=5432
DB_DATABASE=pbr_preview
DB_USERNAME=pbr_preview
DB_PASSWORD=CHANGE_ME_RUNTIME_SECRET

# Target state after the separately approved Redis foundation checkpoint.
CACHE_STORE=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=CHANGE_ME_PREVIEW_REDIS_HOST
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=CHANGE_ME_RUNTIME_SECRET
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=pbr_v3_preview_
REDIS_QUEUE_CONNECTION=default
REDIS_CACHE_CONNECTION=cache

SESSION_DRIVER=file

# F0 Preview may use isolated local private storage only when explicitly approved.
# Private S3-compatible provider provisioning is a separate approved step.
FILESYSTEM_DISK=local
