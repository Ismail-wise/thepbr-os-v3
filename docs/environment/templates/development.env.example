# thePBR OS V3 — Development environment example
# NON-SECRET TEMPLATE ONLY.
# Copy values into an untracked runtime environment only through an approved step.

APP_NAME="thePBR OS V3"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pbr_dev
DB_USERNAME=pbr_dev
DB_PASSWORD=CHANGE_ME_LOCAL_ONLY

# Redis is introduced in the separately approved F0 Redis checkpoint.
CACHE_STORE=file
QUEUE_CONNECTION=sync

SESSION_DRIVER=file

# Local private Laravel storage is acceptable for Development.
FILESYSTEM_DISK=local
