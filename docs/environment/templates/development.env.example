# thePBR OS V3 — Development environment example
# NON-SECRET TEMPLATE ONLY.
# Copy values into an untracked runtime environment only through an approved step.

APP_NAME="thePBR OS V3"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pbr_dev
DB_USERNAME=pbr_dev
DB_PASSWORD=CHANGE_ME_LOCAL_ONLY

# F1-A3 uses the accepted Development Redis foundation for sessions only.
CACHE_STORE=file
QUEUE_CONNECTION=sync

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6380
REDIS_USERNAME=thepbr_os_v3_dev_app
REDIS_PASSWORD=CHANGE_ME_RUNTIME_SECRET
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=thepbr-os-v3:dev:

SESSION_DRIVER=redis
SESSION_STORE=redis
SESSION_CONNECTION=default
SESSION_PREFIX=sessions:
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# Local private Laravel storage is acceptable for Development.
FILESYSTEM_DISK=local
