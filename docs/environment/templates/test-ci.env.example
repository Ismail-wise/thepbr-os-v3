# thePBR OS V3 — Test / CI environment example
# NON-SECRET TEMPLATE ONLY.
# GitHub Actions currently provides CI variables directly; this file is documentation,
# not the authoritative CI runtime configuration.

APP_NAME="thePBR OS V3"
APP_ENV=testing
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=false
APP_URL=http://localhost

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pbr_ci
DB_USERNAME=pbr_ci
DB_PASSWORD=pbr_ci_password

CACHE_STORE=array
QUEUE_CONNECTION=sync
SESSION_DRIVER=array
FILESYSTEM_DISK=local
