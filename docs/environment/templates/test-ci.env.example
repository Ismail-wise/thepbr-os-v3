# thePBR OS V3 — Test / CI environment example
# NON-SECRET TEMPLATE ONLY.
# GitHub Actions currently provides CI variables directly; this file is documentation,
# not the authoritative CI runtime configuration.

APP_NAME="thePBR OS V3"
APP_ENV=testing
APP_KEY=base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
APP_DEBUG=false
APP_URL=http://localhost

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=pbr_ci
DB_USERNAME=pbr_ci
DB_PASSWORD=pbr_ci_password

CACHE_STORE=array
QUEUE_CONNECTION=sync

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PORT=6382
REDIS_USERNAME=thepbr_os_v3_test_app
REDIS_PASSWORD=CHANGE_ME_TEST_CI_ONLY_DISPOSABLE
REDIS_DB=0
REDIS_CACHE_DB=1
REDIS_PREFIX=thepbr-os-v3:test:

SESSION_DRIVER=redis
SESSION_STORE=redis
SESSION_CONNECTION=default
SESSION_PREFIX=sessions:
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
FILESYSTEM_DISK=local
