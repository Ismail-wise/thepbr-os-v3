<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="https://schema.phpunit.de/12.5/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true">
    <testsuites>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>

    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>

    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="CACHE_STORE" value="array"/>
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="REDIS_CLIENT" value="phpredis"/>
        <env name="REDIS_HOST" value="127.0.0.1"/>
        <env name="REDIS_PORT" value="6382"/>
        <env name="REDIS_USERNAME" value="thepbr_os_v3_test_app"/>
        <env name="REDIS_DB" value="0"/>
        <env name="REDIS_CACHE_DB" value="1"/>
        <env name="REDIS_PREFIX" value="thepbr-os-v3:test:"/>
        <!-- REDIS_PASSWORD is injected from the protected Test Redis secret or generated by CI. -->
        <env name="SESSION_DRIVER" value="redis"/>
        <env name="SESSION_STORE" value="redis"/>
        <env name="SESSION_CONNECTION" value="default"/>
        <env name="SESSION_PREFIX" value="sessions:"/>
        <env name="SESSION_ENCRYPT" value="(true)"/>
        <env name="SESSION_SECURE_COOKIE" value="(false)"/>
        <env name="SESSION_HTTP_ONLY" value="(true)"/>
        <env name="SESSION_SAME_SITE" value="lax"/>
    </php>
</phpunit>
